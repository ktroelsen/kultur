<?xml version="1.0" encoding="utf-8"?>
<!-- Publish fills in processPath/arguments. requestTimeout: the nightly scan (POST /api/scan)
     fetches many pages and must not be cut off after ANCM's default two minutes. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout" hostingModel="OutOfProcess" requestTimeout="00:15:00" />
    </system.webServer>
  </location>
</configuration>
