<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Simply: run the self-contained exe out-of-process (same setup as read.kaspert.dk). -->
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
    <!-- Local keys for development: dotnet user-secrets set "Ticketmaster:ApiKey" ... -->
    <UserSecretsId>kultur-api-3b8e1f52-9c4d-4a7e-b6f1-0d2c5e8a9f13</UserSecretsId>
  </PropertyGroup>

  <!-- The dev password (Auth:Password = "dev") must never reach the server. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
